flowchart TD
  %% Generated by conductor graph
  %% Workflow: terminate-demo
  %% Depth: 1

  classDef entryPoint stroke-width:3px
  classDef humanGate stroke:#9c27b0,fill:#f3e5f5
  classDef scriptStep stroke:#ff9800,fill:#fff3e0
  classDef setStep stroke:#4caf50,fill:#e8f5e9
  classDef waitStep stroke:#607d8b,fill:#eceff1
  classDef terminateSuccess stroke:#2e7d32,fill:#e8f5e9
  classDef terminateFailed stroke:#c62828,fill:#ffebee
  classDef workflowStep stroke:#1565c0,fill:#e3f2fd,stroke-dasharray:5 5
  classDef endNode stroke-width:2px
  classDef errorNode stroke:#c62828,stroke-dasharray:5 5

  abort_unsafe("Refuse to run downstream steps on unsafe input")
  noop_exit("No work needed; document already current")
  precheck{{"Classify the upstream document state and route accordingly"}}
  refresh["Refresh the stale document (simulated)"]
  __end__(["$end"])

  precheck --> refresh
  precheck -->|"action == 'abort'"| abort_unsafe
  precheck -->|"action == 'noop'"| noop_exit
  refresh --> __end__

  class __end__ endNode
  class abort_unsafe terminateFailed
  class noop_exit terminateSuccess
  class precheck scriptStep
  class precheck entryPoint
