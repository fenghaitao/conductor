flowchart TD
  %% Generated by conductor graph
  %% Workflow: for-each-simple
  %% Depth: 0

  classDef entryPoint stroke-width:3px
  classDef humanGate stroke:#9c27b0,fill:#f3e5f5
  classDef scriptStep stroke:#ff9800,fill:#fff3e0
  classDef setStep stroke:#4caf50,fill:#e8f5e9
  classDef waitStep stroke:#607d8b,fill:#eceff1
  classDef terminateSuccess stroke:#2e7d32,fill:#e8f5e9
  classDef terminateFailed stroke:#c62828,fill:#ffebee
  classDef workflowStep stroke:#1565c0,fill:#e3f2fd,stroke-dasharray:5 5
  classDef endNode stroke-width:2px
  classDef errorNode stroke:#c62828,stroke-dasharray:5 5

  aggregator["Aggregates results from all processed items"]
  item_finder["Returns items to process — uses provided input or generates random topics"]
  subgraph item_processors["For-Each: item_processors (source: item_finder.output.topics)"]
    direction LR
    item_processor["item_processor (×N)"]
  end

  end(["$end"])

  aggregator --> end
  item_finder --> item_processors
  item_processors --> aggregator

  class end endNode
  class item_finder entryPoint
