flowchart TD
  %% Generated by conductor graph
  %% Workflow: parallel-research
  %% Depth: 0

  classDef entryPoint stroke-width:3px
  classDef humanGate stroke:#9c27b0,fill:#f3e5f5
  classDef scriptStep stroke:#ff9800,fill:#fff3e0
  classDef setStep stroke:#4caf50,fill:#e8f5e9
  classDef waitStep stroke:#607d8b,fill:#eceff1
  classDef terminateSuccess stroke:#2e7d32,fill:#e8f5e9
  classDef terminateFailed stroke:#c62828,fill:#ffebee
  classDef workflowStep stroke:#1565c0,fill:#e3f2fd,stroke-dasharray:5 5
  classDef endNode stroke-width:2px
  classDef errorNode stroke:#c62828,stroke-dasharray:5 5

  planner["Creates a structured research plan"]
  quality_checker["Evaluates research quality and completeness"]
  synthesizer["Synthesizes findings from all parallel researchers"]
  subgraph parallel_researchers["Parallel: parallel_researchers"]
    direction LR
    academic_researcher["Searches academic and scholarly sources"]
    technical_researcher["Searches technical documentation and specifications"]
    web_researcher["Searches web sources and news"]
  end

  __end__(["$end"])

  parallel_researchers --> synthesizer
  planner --> parallel_researchers
  quality_checker --> __end__
  quality_checker -->|"{{ output.quality_score >= 7 }}"| __end__
  quality_checker -.->|"{{ context.iteration < 3 }}"| planner
  synthesizer --> quality_checker

  class __end__ endNode
  class planner entryPoint
